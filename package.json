{
	"name": "@nivalis/n-queue",
	"description": "Redis Queue for Next.js",

	"type": "module",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"packageManager": "pnpm@10.23.0",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/nivalis-studio/n-queue#readme",
	"repository": {
		"url": "git+https://github.com/nivalis-studio/n-queue.git"
	},
	"bugs": {
		"url": "https://github.com/nivalis-studio/n-queue/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"dev": "bun run --watch src/index.tsx",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"prepare": "lefthook install",
		"ts": "tsc --noEmit"
	},

	"dependencies": {
		"uuid": "11.1.0"
	},

	"peerDependencies": {
		"redis": "^4.7.0",
		"typescript": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.6",
		"@commitlint/cli": "20.1.0",
		"@commitlint/config-conventional": "20.0.0",
		"@nivalis/biome-config": "2.3.6",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/bun": "1.3.2",
		"@types/node": "22.2.0",
		"lefthook": "2.0.4",
		"redis": "4.7.0",
		"typescript": "5.9.3",
		"zshy": "^0.6.0"
	},
	"zshy": "./src/index.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.cts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"files": ["LICENSE", "README.md", "dist"]
}
