{
	"name": "@nivalis/n-queue",
	"description": "Redis Queue for Next.js",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"packageManager": "pnpm@10.23.0",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/nivalis-studio/n-queue#readme",
	"repository": {
		"url": "git+https://github.com/nivalis-studio/n-queue.git"
	},
	"bugs": {
		"url": "https://github.com/nivalis-studio/n-queue/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"dev": "bun test --watch",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "bun test",
		"test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from test",
		"test:docker:down": "docker compose -f docker-compose.test.yml down -v",
		"quickstart": "docker compose -f examples/quickstart/docker-compose.yml up --build --abort-on-container-exit",
		"build": "zshy",
		"prepack": "zshy",
		"prepare": "lefthook install",
		"ts": "tsc --noEmit --incremental"
	},
	"dependencies": {
		"effect": "3.19.6",
		"uuid": "11.1.0"
	},
	"peerDependencies": {
		"redis": "^4.7.0",
		"typescript": "^5.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@nivalis/biome-config": "catalog:",
		"@total-typescript/ts-reset": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"lefthook": "catalog:",
		"redis": "^4.7.0",
		"typescript": "catalog:",
		"zshy": "catalog:"
	},
	"zshy": "./src/index.ts",
	"files": ["dist"],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"types": "./dist/index.d.cts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	}
}
